# Performance / quality tuning. Leave these defaults for a responsive CPU setup.
# Set WHISPER_MODEL=medium for more accurate voice recognition on a strong PC.
# Set WHISPER_MODEL=base if you prefer the quickest response on a lower-end PC.
WHISPER_MODEL=small
WHISPER_BEAM_SIZE=3
RECORD_SECONDS=6
MAX_CONTEXT_CHARS=12000
RECENT_MEMORY_ITEMS=8
MAX_RESPONSE_TOKENS=1200
AI_TEMPERATURE=0.45
AI_TIMEOUT_SECONDS=90

# Ollama Models
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEXT_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=llama3.2-vision:11b

GOOGLE_API_KEY=N8a8nPwoeTuAUuvMqwL2Wmt
